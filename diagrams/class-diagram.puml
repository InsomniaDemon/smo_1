@startuml

title Диаграмма классов

skinparam classAttributeIconSize 0
skinparam shadowing false

class Source {
    - id: int
    - intensity: double
    + generateRequest(time): Request
    + getNextGenerationTime(time): double
}

class Request {
    - sourceId: int
    - createdAt: double
    - status: RequestStatus
    + markRejected(time)
}

enum RequestStatus {
    CREATED
    IN_BUFFER
    PROCESSING
    COMPLETED
    REJECTED
}

class PlacementDispatcher {
    - buffer: Buffer
    - selectionDispatcher: SelectionDispatcher
    - statistics: StatisticsCollector
    + placeRequest(request, time)
}

class Buffer {
    - slots: Request[]
    - putPointer: int
    - selectPointer: int
    + findFreeSlot(): int
    + put(request, position)
    + findOldestSlot(): int
    + eject(position): Request
    + selectByRing(): Request
    + hasRequests(): boolean
}

class SelectionDispatcher {
    - buffer: Buffer
    - devices: Device[]
    - calendar: EventCalendar
    - statistics: StatisticsCollector
    + onRequestBuffered(time)
    + onDeviceReleased(time)
    - findFreeDevice(): Device
}

class Device {
    - id: int
    - busy: boolean
    + isFree(): boolean
    + startProcessing(request, time): double
    + finishProcessing(time): Request
}

class EventCalendar {
    - events: Event[]
    + add(event)
    + next(): Event
    + isEmpty(): boolean
}

class Event {
    - time: double
    - type: EventType
}

enum EventType {
    REQUEST_GENERATED
    DEVICE_RELEASED
}

class StatisticsCollector {
    + recordGenerated(request)
    + recordRejected(request)
    + recordServiceStart(request, device)
    + recordCompleted(request, device)
    + buildSummaryTable(): SummaryTable
}

class SimulationEngine {
    - currentTime: double
    - sources: Source[]
    - calendar: EventCalendar
    - placementDispatcher: PlacementDispatcher
    - selectionDispatcher: SelectionDispatcher
    - statistics: StatisticsCollector
    + step()
    + run()
}

SimulationEngine --> Source
SimulationEngine --> EventCalendar
SimulationEngine --> PlacementDispatcher
SimulationEngine --> SelectionDispatcher
SimulationEngine --> StatisticsCollector

PlacementDispatcher --> Buffer
PlacementDispatcher --> SelectionDispatcher
PlacementDispatcher --> StatisticsCollector

SelectionDispatcher --> Buffer
SelectionDispatcher --> Device
SelectionDispatcher --> EventCalendar
SelectionDispatcher --> StatisticsCollector

Source ..> Request : создаёт
Buffer o-- Request
Device --> Request
Request --> RequestStatus
EventCalendar o-- Event
Event --> EventType

note right of Buffer
Д1ОЗ1: поиск свободного места по кольцу от putPointer
Д1ОО3: при полном буфере выбивается самая старая заявка
Д2Б3: выбор заявки по кольцу от selectPointer
end note

note right of SelectionDispatcher
Д2П1: приборы перебираются с П1, берётся первый свободный
end note

note right of Device
ПЗ2: время обслуживания U[a; b]
end note

note right of Source
ИБ, ИЗ1: интервалы между заявками Exp(intensity)
end note

note bottom of StatisticsCollector
ОР1 — сводная таблица.
ОД3 — временные диаграммы
(интервалы приборов, отказы) тоже собирает он.
end note

@enduml
